# Copy this file to src/.env and fill it in.  ->  cp src/.env.example src/.env
#
# Scoped to the auth service only (src/server.js). The game server's own
# config lives in the project root .env / .env.example and is untouched by
# this file.

# Web server port for the auth service.
PORT=5000

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Can point at
# the same Atlas cluster the game server uses, as long as the database name
# in the path (here, fish_battle_auth) differs from the game server's, or at
# a separate cluster entirely.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fish_battle_auth?retryWrites=true&w=majority

# REQUIRED. Signs and verifies JWTs — anyone with this value can forge a valid
# token for any user, so treat it like a password.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-something-long-and-random

# REQUIRED. Gates every /api/admin/* route (src/middleware/adminAuth.js) via
# the x-admin-key header. Change this before deploying anywhere real.
ADMIN_SECRET_KEY=MY_SUPER_SECRET_ADMIN_KEY_2026

# Comma-separated list of Origins allowed to call this API from a browser.
# Every packaged Fish Battle client loads its pages from its own game server
# at http://localhost:<game PORT> — that's the page's Origin on every
# cross-origin fetch to this service, for every install, not a per-user or
# per-install value. One fixed entry covers every distributed install.
ALLOWED_ORIGINS=http://localhost:3000
