# Copy this file to .env and fill it in.  ->  cp .env.example .env

# NOT read by the server anymore — there is no .env fallback/auto-connect.
# The TikTok connection is started only via the admin panel's Connect
# control (POST /api/admin/tiktok/connect, ADMIN_SECRET_KEY required), which
# takes the username from that request, not from here. Left as documentation
# only; safe to delete this line.
TIKTOK_USERNAME=

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). No local
# MongoDB install needed. MONGO_DB is the database name within the cluster —
# it's applied explicitly by server/store.js regardless of any db name in
# the URI's path, so it's safe to leave the URI's path empty as below.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=tiktok_fish_battle

# REQUIRED. The server refuses to start without this.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET_KEY=change-me-to-something-long-and-random

# Web server port
PORT=3000

# Base URL of the auth service's /api/auth routes, told to the browser
# client via GET /api/config. Defaults to the old same-machine dev value
# below, so local development (this server + `node src/server.js` both on
# one machine) needs no change. Once the auth service is hosted elsewhere,
# point this at its public HTTPS URL, e.g. https://auth.example.com/api/auth
AUTH_API_BASE_URL=http://localhost:5000/api/auth

# Cap on simultaneously rendered fish. Raise only if your GPU can take it.
MAX_ACTIVE_FISH=40

# Set to true to fire fake gifts on a timer instead of connecting to TikTok.
SIMULATE=false

# Euler Stream signing key — REQUIRED for live TikTok connections.
# TikTok signs its webcast requests with obfuscated browser parameters; the
# library delegates that signing to Euler Stream. Without a key you will see
# "Failed to sign request ... 404". Free key, takes a minute:
#   https://www.eulerstream.com
EULER_API_KEY=
